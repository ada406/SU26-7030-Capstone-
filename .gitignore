# Conda / Python
.conda/
.conda-env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Secrets
.kaggle/
**/kaggle.json
.env

# Data (download locally; do not commit large CSVs)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts / figures
# Keep the trained genre model + metrics trackable for the repo once reviewed.
models/*
!models/.gitkeep
!models/genre_classifier.joblib
!models/metrics.json
!models/feature_columns.json
outputs/*
!outputs/.gitkeep
!outputs/test_predictions.csv
!outputs/confusion_matrix.png
!outputs/confusion_matrix_normalized.png
*.pkl

# Local transfer archives (do not commit)
*.zip
Miniforge3-*.sh
Miniconda3-*.sh
Anaconda3-*.sh
